{
  "name": "detox-starter",
  "version": "1.0.0",
  "description": "A boilerplate for end-to-end testing using Detox for native mobile applications on iOS and Android",
  "main": "index.js",
  "scripts": {
    "test:e2e:ios:debug": "detox test --configuration ios.sim.debug",
    "test:e2e:ios:release": "detox test --configuration ios.sim.release",
    "test:e2e:android:debug": "detox test --configuration android.emu.debug",
    "test:e2e:android:release": "detox test --configuration android.emu.release",
    "test:e2e:bs:ios": "detox test --configuration bs.ios",
    "test:e2e:bs:android": "detox test --configuration bs.android",
    "build:e2e:ios:debug": "detox build --configuration ios.sim.debug",
    "build:e2e:ios:release": "detox build --configuration ios.sim.release",
    "build:e2e:android:debug": "detox build --configuration android.emu.debug",
    "build:e2e:android:release": "detox build --configuration android.emu.release",
    "lint": "eslint e2e --ext .js,.ts",
    "lint:fix": "eslint e2e --ext .js,.ts --fix"
  },
  "keywords": [
    "detox",
    "e2e",
    "testing",
    "ios",
    "android",
    "browserstack",
    "mobile",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "detox": "^20.14.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "form-data": "^4.0.0",
    "jest": "^29.7.0",
    "jest-html-reporters": "^3.1.4",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "detox": {
    "test-runner": "jest",
    "runner-config": "e2e/config.json",
    "configurations": {
      "ios.sim.debug": {
        "device": {
          "type": "iPhone 14"
        },
        "app": "ios.debug"
      },
      "ios.sim.release": {
        "device": {
          "type": "iPhone 14"
        },
        "app": "ios.release"
      },
      "android.emu.debug": {
        "device": {
          "avdName": "Pixel_5_API_31"
        },
        "app": "android.debug"
      },
      "android.emu.release": {
        "device": {
          "avdName": "Pixel_5_API_31"
        },
        "app": "android.release"
      },
      "bs.ios": {
        "type": "ios.none",
        "device": {
          "type": "iPhone 14"
        },
        "app": "bs.ios",
        "session": {
          "server": "ws://localhost:8099",
          "sessionId": "BrowserStack"
        }
      },
      "bs.android": {
        "type": "android.none",
        "device": {
          "avdName": "Pixel_5_API_31"
        },
        "app": "bs.android",
        "session": {
          "server": "ws://localhost:8099",
          "sessionId": "BrowserStack"
        }
      }
    },
    "apps": {
      "ios.debug": {
        "type": "ios.app",
        "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/YourApp.app",
        "build": "xcodebuild -workspace ios/YourApp.xcworkspace -scheme YourApp -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build"
      },
      "ios.release": {
        "type": "ios.app",
        "binaryPath": "ios/build/Build/Products/Release-iphonesimulator/YourApp.app",
        "build": "xcodebuild -workspace ios/YourApp.xcworkspace -scheme YourApp -configuration Release -sdk iphonesimulator -derivedDataPath ios/build"
      },
      "android.debug": {
        "type": "android.apk",
        "binaryPath": "android/app/build/outputs/apk/debug/app-debug.apk",
        "build": "cd android && ./gradlew assembleDebug assembleAndroidTest -DtestBuildType=debug"
      },
      "android.release": {
        "type": "android.apk",
        "binaryPath": "android/app/build/outputs/apk/release/app-release.apk",
        "build": "cd android && ./gradlew assembleRelease assembleAndroidTest -DtestBuildType=release"
      },
      "bs.ios": {
        "type": "ios.none",
        "binaryPath": "BrowserStack"
      },
      "bs.android": {
        "type": "android.none",
        "binaryPath": "BrowserStack"
      }
    }
  }
}
