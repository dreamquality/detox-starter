# Environment variables template
# Copy this file to .env and fill in your actual values

# BrowserStack credentials
BROWSERSTACK_USERNAME=your_browserstack_username
BROWSERSTACK_ACCESS_KEY=your_browserstack_access_key
BROWSERSTACK_SERVER=ws://localhost:8099

# Test configuration
TEST_TIMEOUT=120000
DETOX_ARTIFACTS_LOCATION=./e2e/artifacts

# App configuration
IOS_APP_PATH=ios/build/Build/Products/Release-iphonesimulator/YourApp.app
ANDROID_APP_PATH=android/app/build/outputs/apk/release/app-release.apk

# Device configuration
IOS_SIMULATOR=iPhone 14
ANDROID_EMULATOR=Pixel_5_API_31

# Logging
LOG_LEVEL=info
VERBOSE=false
